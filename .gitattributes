# Git 行尾规范化配置
# 确保跨平台开发时的一致性

# 自动检测文本文件并规范化行尾
* text=auto

# 源代码文件 - 使用 LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf

# Shell 脚本 - 必须使用 LF
*.sh text eol=lf

# Windows 批处理文件 - 使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 配置文件 - 使用 LF
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.eslintrc text eol=lf
.prettierrc text eol=lf

# 二进制文件 - 不转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.node binary

# 包管理器锁文件 - 使用 LF
package-lock.json text eol=lf
yarn.lock text eol=lf
pnpm-lock.yaml text eol=lf

# Git 配置
.gitconfig text eol=lf

# 语言统计（GitHub Linguist）
*.md linguist-documentation
docs/** linguist-documentation
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript
