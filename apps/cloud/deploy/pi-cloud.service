[Unit]
Description=Pi Cloud control plane (Pi Workbench)
Documentation=https://github.com/T-Chen-CN/pi-workbench
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=pi-cloud
Group=pi-cloud
WorkingDirectory=/opt/pi-cloud/current
EnvironmentFile=/etc/pi-cloud/env
# node 的安装位置因系统而异（apt 在 /usr/bin，nodejs.org tarball 在 /usr/local/bin）。
# systemd 的服务 PATH 含 /usr/local/bin，用 env 解析即可，不要写死绝对路径。
ExecStart=/usr/bin/env node /opt/pi-cloud/current/dist/main.js
Restart=always
RestartSec=2
TimeoutStopSec=15s
# 云端只监听 127.0.0.1，TLS 与 WS 升级交给 Caddy
Environment=NODE_ENV=production

# 收紧权限：只允许写数据目录（/var/backups/pi-cloud 仅限独立备份任务写入，防运行期被篡改）
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
LockPersonality=true
MemoryMax=1500M
ReadWritePaths=/var/lib/pi-cloud
# 云主机本地 stdio MCP 服务器可部署在 /opt/pi-cloud/mcp（只读可执行）或 /var/lib/pi-cloud/mcp（可读写）；
# 前缀 `-` 表示目录不存在时忽略，确保既有未创建该目录的实例正常启动。
ReadOnlyPaths=-/opt/pi-cloud/mcp

StandardOutput=journal
StandardError=journal
SyslogIdentifier=pi-cloud

# 需求 §3.5 的运维硬约束：默认 ulimit -n 只有 1024，两条 WS 通道 + 会话文件在并发下会先撞 fd 上限
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
