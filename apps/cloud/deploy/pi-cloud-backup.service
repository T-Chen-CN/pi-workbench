[Unit]
Description=Pi Cloud daily backup
Documentation=https://github.com/T-Chen-CN/pi-workbench

[Service]
Type=oneshot
User=pi-cloud
Group=pi-cloud
# 备份任务不加载 /etc/pi-cloud/env，遵循最小权限原则，绝不接触 PI_CLOUD_ENC_KEY / PI_CLOUD_COOKIE_SECRET
ExecStart=/opt/pi-cloud/backup.sh
UMask=0077
NoNewPrivileges=true
# 备份需写 /var/backups/pi-cloud；SQLite WAL 模式下 .backup 在无主进程持锁时可能需要建 -shm，故 /var/lib/pi-cloud 保留读写
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/pi-cloud /var/backups/pi-cloud
