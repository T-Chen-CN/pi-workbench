# /etc/pi-cloud/env —— systemd EnvironmentFile（权限 600，属主 root 或 pi-cloud）
#
# 三项必填：
#   PI_CLOUD_ENC_KEY        32 字节 base64，云端模型 Key 的 AES-256-GCM 主密钥
#                          生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#                          **必须与备份一起保存**：丢了就解不开 config.json 里的模型 Key
#   PI_CLOUD_COOKIE_SECRET  登录 cookie 的 HMAC 密钥（随机 32+ 字符）
#   PI_CLOUD_DATA_DIR       运行期数据目录

PI_CLOUD_ENC_KEY=
PI_CLOUD_COOKIE_SECRET=
PI_CLOUD_DATA_DIR=/var/lib/pi-cloud
PI_CLOUD_WORKSPACE_DIR=/var/lib/pi-cloud/workspace
PI_CLOUD_AGENT_DIR=/var/lib/pi-cloud/agent

# 只监听回环：TLS 与 WS 升级交给 Caddy
PI_CLOUD_HOST=127.0.0.1
PI_CLOUD_PORT=8787
PI_CLOUD_DOMAIN=cloud.example.com
PI_CLOUD_VERSION=0.1.0
# 可选：首次创建管理员账号 `/v1/setup` 所需的启动令牌，公网首次初始化建议配置防抢注
# PI_CLOUD_SETUP_TOKEN=
