{
  "name": "pi-workbench",
  "version": "0.7.0",
  "description": "Lightweight desktop code editor with Pi Agent integration",
  "main": "dist-electron/main.js",
  "type": "module",
  "workspaces": [
    "pi-bridge"
  ],
  "scripts": {
    "predev": "npm run build:bridge && npm run build:main",
    "dev": "concurrently \"npm run web:dev\" \"npm run electron:dev\" --kill-others",
    "web:dev": "vite",
    "electron:dev": "wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run build:renderer && npm run build:bridge && npm run build:main",
    "build:renderer": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "build:main": "tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.preload.json",
    "build:bridge": "cd pi-bridge && npm run build",
    "type-check": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"electron/**/*.{ts,cts}\" \"pi-bridge/src/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,js,json,md}\""
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.4.299",
    "pi-bridge": "*",
    "pi-web-access": "0.45.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.21",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.60.0",
    "monaco-editor": "^0.57.0",
    "postcss": "^8.4.32",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.0",
    "unified": "^11.0.5",
    "vite": "^5.1.0",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0",
    "zustand": "^4.4.0"
  },
  "build": {
    "appId": "com.piworkbench.app",
    "productName": "Pi Workbench",
    "protocols": [
      {
        "name": "Pi Workbench OAuth",
        "schemes": [
          "pi-workbench"
        ]
      }
    ],
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "T-Chen-CN",
        "repo": "pi-workbench"
      }
    ],
    "directories": {
      "output": "release"
    },
    "afterPack": "./scripts/after-pack-manifest.js",
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "pi-bridge/dist/**/*",
      "pi-bridge/package.json",
      "app-icon.png",
      "app-icon.ico"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "app-icon.ico",
      "artifactName": "Pi-Workbench-Setup-${version}.${ext}"
    },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "include": "build/installer.nsh",
      "installerIcon": "app-icon.ico",
      "uninstallerIcon": "app-icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ],
      "license": "LICENSE"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "app-icon.png",
      "identity": null,
      "x64ArchFiles": "Contents/Resources/app.asar.unpacked/node_modules/**",
      "artifactName": "Pi-Workbench-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "app-icon.png",
      "artifactName": "Pi-Workbench-${version}.${ext}"
    }
  },
  "author": "Pi Workbench Team",
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T-Chen-CN/pi-workbench.git"
  },
  "allowScripts": {
    "node-pty": true,
    "esbuild": true
  }
}
