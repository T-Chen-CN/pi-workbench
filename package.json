{
  "name": "pi-workbench",
  "version": "0.1.0",
  "description": "Lightweight desktop code editor with Pi Agent integration",
  "main": "dist-electron/main.js",
  "type": "module",
  "workspaces": [
    "pi-bridge"
  ],
  "scripts": {
    "predev": "npm run build:bridge && npm run build:main",
    "dev": "concurrently \"npm run web:dev\" \"npm run electron:dev\" --kill-others",
    "web:dev": "vite",
    "electron:dev": "wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run build:renderer && npm run build:bridge && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.preload.json",
    "build:bridge": "cd pi-bridge && npm run build",
    "type-check": "tsc --noEmit",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"electron/**/*.{ts,cts}\" \"pi-bridge/src/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,js,json,md}\""
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "monaco-editor": "^0.57.0",
    "pi-bridge": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.1.0",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.piworkbench.app",
    "productName": "Pi Workbench",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "pi-bridge/dist/**/*",
      "pi-bridge/package.json",
      "app-icon.png",
      "app-icon.ico"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "app-icon.ico"
    },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "app-icon.ico",
      "uninstallerIcon": "app-icon.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "license": "LICENSE"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "app-icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "app-icon.png"
    }
  },
  "author": "Pi Workbench Team",
  "engines": {
    "node": ">=22.19.0"
  }
}
