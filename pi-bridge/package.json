{
  "name": "pi-bridge",
  "version": "0.1.0",
  "description": "Node.js bridge for Pi Agent integration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./atomic-json": {
      "types": "./dist/atomic-json.d.ts",
      "import": "./dist/atomic-json.js",
      "default": "./dist/atomic-json.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "default": "./dist/protocol.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js",
      "default": "./dist/presets.js"
    },
    "./images": {
      "types": "./dist/images.d.ts",
      "import": "./dist/images.js",
      "default": "./dist/images.js"
    },
    "./dist/*": "./dist/*"
  },
  "typesVersions": {
    "*": {
      "atomic-json": ["./dist/atomic-json.d.ts"],
      "protocol": ["./dist/protocol.d.ts"],
      "presets": ["./dist/presets.d.ts"],
      "images": ["./dist/images.d.ts"]
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.3.3"
  }
}
