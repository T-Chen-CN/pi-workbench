{
  "name": "pi-bridge",
  "version": "0.1.0",
  "description": "Node.js bridge for Pi Agent integration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./atomic-json": {
      "types": "./dist/atomic-json.d.ts",
      "import": "./dist/atomic-json.js",
      "default": "./dist/atomic-json.js"
    },
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.3.3"
  }
}
